# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# --- Modelos 3D: fuera del repo por tamano ---
# Suman ~2.6 GB y varios .glb rozan el limite de 100 MB por archivo de GitHub.
# El juego arranca igual con primitivas de respaldo cuando faltan (ver
# recursos.crear_visual y la seccion "Assets" del README).
modelos/**/*.glb
modelos/**/*.gltf
modelos/**/*.bin
modelos/**/*.blend

# Copias del proyecto descargadas de GitHub (el ZIP de una rama se descomprime
# como "guardianes-del-eclipse-<rama>"). Traen sus propios modelos y sus rutas NO
# las cubren los patrones de arriba, que estan anclados a la raiz del repo: sin
# esta linea, un "git add -A" subiria varios GB de .glb duplicados.
guardianes-del-eclipse-*/

# --- Sistema / editores ---
.DS_Store
Thumbs.db
.idea/
